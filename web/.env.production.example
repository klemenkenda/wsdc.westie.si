# Copy this to web/.env on the server and fill in your values.
# Do NOT commit web/.env itself.

APP_NAME="SLO WSDC Ranking"
APP_ENV=production
APP_KEY=          # run: php web/artisan key:generate --show  then paste here
APP_DEBUG=false
APP_URL=https://yourdomain.com

LOG_CHANNEL=single
LOG_LEVEL=error

SESSION_DRIVER=file
CACHE_STORE=file

# Secret required to trigger the scraper from the web UI (choose a strong password)
SCRAPER_SECRET=

# Full path to the PHP CLI binary on the server (needed on shared hosts where
# the system default php is a different version than the web PHP).
# Example: /opt/cpanel/ea-php83/root/usr/bin/php
PHP_CLI_BIN=
